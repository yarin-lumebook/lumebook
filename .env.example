# Environment variables the LumeBook scripts read. Names only: put real values in your shell
# (~/.zshrc on the Mac) or in the Claude Code cloud environment, never in a committed file.

# fal.ai key for paid image generation: carousel production runs
# (carousel/carousel-pipeline/scripts/fal_generate.py) and the frozen fal trial
# (media/projects/2026-10-06-fal-carousel-trial/source/fal_generate.py). Not needed for the nightly review pack.
FAL_KEY=your-fal-key-here

# Optional: port for the carousel review server (carousel/carousel-pipeline/scripts/review_server.py). Default 8777.
PORT=8777

# Optional: Chrome or Chromium for the carousel slide renders, only if find_chrome() misses it (README section 9).
# CHROME_PATH=/usr/bin/chromium
