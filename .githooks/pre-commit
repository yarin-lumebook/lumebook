#!/bin/sh
# LumeBook monorepo pre-commit checks.
# Never commit a Sheet export (phones, emails): the old signup sheet.md or the ambassadors Sheet export.
# (The SMM plan's English-mirror rule went with the plan page, retired 8 Nov 2026.)
staged=$(git diff --cached --name-only)
if echo "$staged" | grep -q "sheet\.md$"; then
  echo "pre-commit: a Sheet export (*sheet.md) is staged; it holds phone numbers and emails. Unstage it."
  exit 1
fi
exit 0
