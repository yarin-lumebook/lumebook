nZpZGVvX3VzZXJfc2VsZWN0ZWRfdGh1bWJuYWlsLkMzIn0%3D&_nc_ohc=CysQxlTeOeUQ7kNvwEqG07h&_nc_oc=AdrbkW3BdT7SAOmgb8TTM02JQfThSQm5Oavjy1ihoJ1ls7fhz5ByVyL9JITqUR9kiCA&_nc_zt=23&_nc_ht=instagram.ftlv6-1.fna&_nc_gid=cvPxJYtwq9byG44owpTqMQ&_nc_ss=70689&_nc_ct=RQosPBUIFQ4lBAAAAA&oh=00_AQT8ffV1dTs2uIqVgVG1j8iPAyqSemAbqMEP8pQehEEZjQ&oe=6AFF39A9", "width": 1080, "height": 1080, "id": "11", "resolution": "1080x1080"}, {"url": "https://instagram.ftlv6-1.fna.fbcdn.net/v/t51.82787-15/772928408_18557598769077956_3092069157548610200_n.jpg?stp=dst-jpg_e35_p1080x1080_sh2.08_tt6&_nc_cat=108&_nc_map=urlgen_bucketless&ig_cache_key=Mzk2MjAyODcwOTA3MzQ0NjAyOTE4NTU3NTk4NzYzMDc3OTU2.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEyMDYuc2RyLnZpZGVvX3VzZXJfc2VsZWN0ZWRfdGh1bWJuYWlsLkMzIn0%3D&_nc_ohc=CysQxlTeOeUQ7kNvwEqG07h&_nc_oc=AdrbkW3BdT7SAOmgb8TTM02JQfThSQm5Oavjy1ihoJ1ls7fhz5ByVyL9JITqUR9kiCA&_nc_zt=23&_nc_ht=instagram.ftlv6-1.fna&_nc_gid=cvPxJYtwq9byG44owpTqMQ&_nc_ss=70689&_nc_ct=RQosPBUIFQ4lBAAAAA&oh=00_AQQns45q8b13Nii7-Oexs4GSOKpYSNp91A2LEh3OmVCnNQ&oe=6AFF39A9", "width": 1080, "height": 1920, "id": "12", "resolution": "1080x1920"}, {"url": "https://instagram.ftlv6-1.fna.fbcdn.net/v/t51.82787-15/772928408_18557598769077956_3092069157548610200_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=108&_nc_map=urlgen_bucketless&ig_cache_key=Mzk2MjAyODcwOTA3MzQ0NjAyOTE4NTU3NTk4NzYzMDc3OTU2.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEyMDYuc2RyLnZpZGVvX3VzZXJfc2VsZWN0ZWRfdGh1bWJuYWlsLkMzIn0%3D&_nc_ohc=CysQxlTeOeUQ7kNvwEqG07h&_nc_oc=AdrbkW3BdT7SAOmgb8TTM02JQfThSQm5Oavjy1ihoJ1ls7fhz5ByVyL9JITqUR9kiCA&_nc_zt=23&_nc_ht=instagram.ftlv6-1.fna&_nc_gid=cvPxJYtwq9byG44owpTqMQ&_nc_ss=70689&_nc_ct=RQosPBUIFQ4lBAAAAA&oh=00_AQTuYw8xKgi8bD5gNQXbL9M09ImAHS1xAmSSYsvLUu1UqA&oe=6AFF39A9", "width": 1206, "height": 2144, "id": "13", "resolution": "1206x2144"}], "comments": [{"author": "elmm.37476622", "author_id": "32642118231", "id": "18174387376376379", "text": "ישו המשיח, בן מרים (עליו השלום) הועלו טענות שקריות נגד המשיח: שהוא בן האלוהים, שהוא נצלב ונהרג, ושהוא אלוהים. אין מדובר בבדיה אחת בלבד, אלא בסדרה של שקרים. משה (עליו השלום) – הנביא שאלוהים הכול-יכול שלח אל בני ישראל – נשא עמו אותות ברורים ואת התורה. אלוהים הכול-יכול שלח את הנביא ישו (עליו השלום) אל בני ישראל, כשהוא נושא עמו אות ברור ואת הבשורה (האינג'יל). הגישה כלפיהם זהה: שניהם היו שליחי האל – יתעלה הודו – ולא אלים. היכן, אם כן, ישו בן מרים? אלוהים הכול-יכול העלה אותו אליו – ואתם יודעים שהוא הועלה – אך מדוע טענתם שצלבתם והרגתם אותו? ישו בן מרים נהג להתפלל ולומר: \"עבדו את אלוהים, ריבוני וריבונכם.\" אך למרבה הפלא, הם לא האמינו בו – למעט מעטים – וביקשו להורגו. הוא בן-אנוש כמונו, לא אל. יתרה מכך, אתם דבקים בדוקטרינה אוונגליסטית השואפת לנוכחות יהודים בפלסטין כדי לאפשר את ירידתו של ישו בן מרים (עליו השלום). אם אתם מאמינים שהוא אלוהים, האם בכוונתכם לשלוט במועד ירידתו? האם יש לעבדים סמכות על אל, או שמא ההפך הוא הנכון? למעשה, ישו בן מרים (עליו השלום) אינו אל; הוא בן-אנוש... ...עבד ושליח של האל – יתעלה כוחו. 🤌🏻🙋🏻‍♂️", "timestamp": 1789261025, "like_count": 0}, {"author": "henshiraalon_clinik", "author_id": "779458743", "id": "18005523728992228", "text": "וענההההה איזה מותק", "timestamp": 1787482383, "like_count": 0}, {"author": "edenanfelt", "author_id": "179759506", "id": "18022261856908730", "text": "אני מכירה את הסיפור הזה", "timestamp": 1787232286, "like_count": 0}, {"author": "ohadhen", "author_id": "23946155", "id": "18405307543094424", "text": "מה אנחנו אומרים יא מניאאאק!", "timestamp": 1787220255, "like_count": 0}, {"author": "noa.atiias", "author_id": "196780694", "id": "18108988627858056", "text": "איזה רזה עשו אותך לירון הגזימו 🤣", "timestamp": 1787213600, "like_count": 0}, {"author": "mali154", "author_id": "803178506", "id": "18167996623459265", "text": "חחחחחחח למה באלי המשך", "timestamp": 1787160350, "like_count": 0}, {"author": "natali_dinaperron", "author_id": "313437878", "id": "18098788343369938", "text": "😂😂😂מושלם", "timestamp": 1787152493, "like_count": 0}, {"author": "_