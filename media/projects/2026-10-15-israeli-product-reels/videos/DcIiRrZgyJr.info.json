tless&ig_cache_key=Mzk2NTU3MDIyMDMxMTEyNjYzNTE4NjE0Nzk1ODY2MDM5MTU3.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjcyMC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=tukWZlnPWwkQ7kNvwFCxdU-&_nc_oc=AdrjpAOealAKs1xI8h44VMm0wT-IWkJghp8IoWrYGtEoYCHajwtRZTEn7Gvi1v-sAC0&_nc_zt=23&_nc_ht=instagram.ftlv6-1.fna&_nc_gid=Pf7t1sgGFEC3QBPVw9mGuA&_nc_ss=70689&oh=00_AQPeF-H3WBeioF3Pdc19462-ZYf2__CKnw0Z4S6f-GJT9w&oe=6AD6C981", "width": 720, "height": 720, "id": "10", "resolution": "720x720"}, {"url": "https://instagram.ftlv6-1.fna.fbcdn.net/v/t51.82787-15/778816546_18614795869039157_3095578060932718872_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=105&_nc_map=urlgen_bucketless&ig_cache_key=Mzk2NTU3MDIyMDMxMTEyNjYzNTE4NjE0Nzk1ODY2MDM5MTU3.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjcyMC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=tukWZlnPWwkQ7kNvwFCxdU-&_nc_oc=AdrjpAOealAKs1xI8h44VMm0wT-IWkJghp8IoWrYGtEoYCHajwtRZTEn7Gvi1v-sAC0&_nc_zt=23&_nc_ht=instagram.ftlv6-1.fna&_nc_gid=Pf7t1sgGFEC3QBPVw9mGuA&_nc_ss=70689&oh=00_AQPGrGAqtrN041HUsZi2Q_C5HvV9k0UjJ5kXODeLS7g0GQ&oe=6AD6C981", "width": 720, "height": 1280, "id": "11", "resolution": "720x1280"}], "comments": [{"author": "liad_nave", "author_id": "5370650156", "id": "18002045406038926", "text": "שירות הלקוחות של הדיוטי פרי הוא פשוט בושה וחרפה. ההורים שלי רוכשים אצלכם מדי שנה בסכומים של כ־2,000 דולר, ובכל פעם שמתעוררת בעיה אנחנו נאלצים לעבור מסכת ייסורים של אינספור שיחות והמתנות. לפני כחודש ההורים שלי קיבלו את הקנייה שלהם בשקית פתוחה, וכבר במונית גילו שחסר מוצר בשווי 40 דולר. לאחר פניות חוזרות לשירות הלקוחות, הנציגה מסרה לנו שלטענת החברה נבדקו מצלמות האבטחה בנקודות האריזה והמסירה. בהמשך היא שאלה אם לנו יש תיעוד מרגע קבלת המוצרים. בעיניי, עצם השאלה הזאת היא חוצפה שאין כדוגמתה! ממתי לקוח אמור לתעד את עצמו מקבל שקית קניות כדי שיוכל להוכיח בדיעבד שחסר בה מוצר? הנציגה אף אמרה לנו שאתם \"חברה שמכבדת את עצמה\". חברה שמכבדת את עצמה לא מטרטרת לקוחות במשך אינספור שיחות ולא מצפה מהם להחזיק בתיעוד של קבלת הקניות שלהם. חוויית הקנייה בדיוטי פרי היא אמנם מהנה, מרגשת ומלאת ציפייה, אבל כמה חבל ששירות הלקוחות שלכם הוא ההפך הגמור ממנה. העניין הוא מזמן לא 40 הדולר, אלא היחס המזלזל, ההתנהלות המתישה והיעדר פתרון ראוי. פשוט מביש!\n@dutyfree_il", "timestamp": 1791970039, "like_count": 0}, {"author": "oliverouri", "author_id": "2085483", "id": "17878984989529591", "text": "אבא מאור עיניים ישמח לב 😍", "timestamp": 1788177390, "like_count": 0}, {"author": "zaksimon", "author_id": "49829426", "id": "18115055087285607", "text": "חזקקק", "timestamp": 1788117287, "like_count": 0}, {"author": "bloominina", "author_id": "47391156010", "id": "18081758204320260", "text": "אלוףףף ❤️", "timestamp": 1788114617, "like_count": 1}, {"author": "brahameital", "author_id": "180420650", "id": "18482377381096600", "text": "חח גאוני", "timestamp": 1788103970, "like_count": 0}, {"author": "ofir_hadash", "author_id": "50902606", "id": "17964301470150329", "text": "🔥🔥🔥🔥🔥", "timestamp": 1786977825, "like_count": 0}, {"author": "orelkayamzuti", "author_id": "10166342", "id": "17913052797444331", "text": "טוב העריכה מחרפנת וגאוניתתת", "timestamp": 1786973438, "like_count": 0}, {"author": "erezled", "author_id": "10651519", "id": "18123622789824337", "text": "כוכב 💚", "timestamp": 1786968161, "like_count": 0}, {"author": "dortrudel", "author_id": "230935456", "id": "18373430614238505", "text": "למה דין קיבל רק 1?", "timestamp": 1786957355, "like_count": 0}, {"author": "aharondor", "author_id": "1304835224", "id": "17858402088696804", "text": "מקצוען", "timestamp": 1786955739, "like_count": 0}, {"author": "noy.imunoy", "author_id": "20515629", "id": "18093053714432176", "text": "מה עם מתנה לדודה?", "timestamp": 1786955377, "like_count": 0}, {"author": "maayan.shtrudel", "author_id": "3187002867", "id": "18108054479025070", "text": "הכי חתיך והוא שלי♥️", "timestamp": 1786955056, "like_count": 0}, {"author": "maayan.shtrudel", "author_id": "3187002867", "id": "18030382589837788", "text": "לא ה