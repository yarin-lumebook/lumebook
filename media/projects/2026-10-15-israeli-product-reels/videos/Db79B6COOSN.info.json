Yuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=HwZXjaNh2xIQ7kNvwHwZ_BA&_nc_oc=AdpbCp0jXixvyCt_n1XJtmA_-jeskRh9qfGc1JFOxWgPlgz0P4Yij-GlbYdljKSVlAg&_nc_zt=23&_nc_ht=instagram.ftlv6-1.fna&_nc_gid=QDwvB27Wsglkxkq2p27KhQ&_nc_ss=70689&oh=00_AQPRPB2UwrfcOogrjxNe4JAuapm7_X81aBPE65NX28NV8w&oe=6AD69369", "width": 1080, "height": 1920, "id": "12", "resolution": "1080x1920"}, {"url": "https://instagram.ftlv6-1.fna.fbcdn.net/v/t51.82787-15/772928408_18557598769077956_3092069157548610200_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=108&_nc_map=urlgen_bucketless&ig_cache_key=Mzk2MjAyODcwOTA3MzQ0NjAyOTE4NTU3NTk4NzYzMDc3OTU2.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEyMDYuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=HwZXjaNh2xIQ7kNvwHwZ_BA&_nc_oc=AdpbCp0jXixvyCt_n1XJtmA_-jeskRh9qfGc1JFOxWgPlgz0P4Yij-GlbYdljKSVlAg&_nc_zt=23&_nc_ht=instagram.ftlv6-1.fna&_nc_gid=QDwvB27Wsglkxkq2p27KhQ&_nc_ss=70689&oh=00_AQMvrWn25aykDWn3dsocvT_92gvt-zqoFsrFyrTmCFWzfg&oe=6AD69369", "width": 1206, "height": 2144, "id": "13", "resolution": "1206x2144"}], "comments": [{"author": "elmm.37476622", "author_id": "32642118231", "id": "18174387376376379", "text": "ישו המשיח, בן מרים (עליו השלום) הועלו טענות שקריות נגד המשיח: שהוא בן האלוהים, שהוא נצלב ונהרג, ושהוא אלוהים. אין מדובר בבדיה אחת בלבד, אלא בסדרה של שקרים. משה (עליו השלום) – הנביא שאלוהים הכול-יכול שלח אל בני ישראל – נשא עמו אותות ברורים ואת התורה. אלוהים הכול-יכול שלח את הנביא ישו (עליו השלום) אל בני ישראל, כשהוא נושא עמו אות ברור ואת הבשורה (האינג'יל). הגישה כלפיהם זהה: שניהם היו שליחי האל – יתעלה הודו – ולא אלים. היכן, אם כן, ישו בן מרים? אלוהים הכול-יכול העלה אותו אליו – ואתם יודעים שהוא הועלה – אך מדוע טענתם שצלבתם והרגתם אותו? ישו בן מרים נהג להתפלל ולומר: \"עבדו את אלוהים, ריבוני וריבונכם.\" אך למרבה הפלא, הם לא האמינו בו – למעט מעטים – וביקשו להורגו. הוא בן-אנוש כמונו, לא אל. יתרה מכך, אתם דבקים בדוקטרינה אוונגליסטית השואפת לנוכחות יהודים בפלסטין כדי לאפשר את ירידתו של ישו בן מרים (עליו השלום). אם אתם מאמינים שהוא אלוהים, האם בכוונתכם לשלוט במועד ירידתו? האם יש לעבדים סמכות על אל, או שמא ההפך הוא הנכון? למעשה, ישו בן מרים (עליו השלום) אינו אל; הוא בן-אנוש... ...עבד ושליח של האל – יתעלה כוחו. 🤌🏻🙋🏻‍♂️", "timestamp": 1789261025, "like_count": 0}, {"author": "henshiraalon_clinik", "author_id": "779458743", "id": "18005523728992228", "text": "וענההההה איזה מותק", "timestamp": 1787482383, "like_count": 0}, {"author": "edenanfelt", "author_id": "179759506", "id": "18022261856908730", "text": "אני מכירה את הסיפור הזה", "timestamp": 1787232286, "like_count": 0}, {"author": "ohadhen", "author_id": "23946155", "id": "18405307543094424", "text": "מה אנחנו אומרים יא מניאאאק!", "timestamp": 1787220255, "like_count": 0}, {"author": "noa.atiias", "author_id": "196780694", "id": "18108988627858056", "text": "איזה רזה עשו אותך לירון הגזימו 🤣", "timestamp": 1787213600, "like_count": 0}, {"author": "mali154", "author_id": "803178506", "id": "18167996623459265", "text": "חחחחחחח למה באלי המשך", "timestamp": 1787160350, "like_count": 0}, {"author": "natali_dinaperron", "author_id": "313437878", "id": "18098788343369938", "text": "😂😂😂מושלם", "timestamp": 1787152493, "like_count": 0}, {"author": "_harel.raz_", "author_id": "6209605826", "id": "18187906786402034", "text": "🔥", "timestamp": 1787150707, "like_count": 0}, {"author": "einav_sharabyy", "author_id": "433253839", "id": "17932364967127429", "text": "😂😂😂😂😂", "timestamp": 1787134979, "like_count": 0}, {"author": "hanishitrit", "author_id": "3719911", "id": "18125938045724699", "text": "חחחח בוכה 😂", "timestamp": 1787129798, "like_count": 0}, {"author": "sigal_saroya", "author_id": "4253794590", "id": "17952060984215535", "text": "@yardenelmalah 😂😂😂😂", "timestamp": 1787078220, "like_count": 0}, {"author": "noymazal_boblil", "author_id": "284803486", "id": "18130148956654044", "text": "אותי הצחיק שהצ׳ט עשה אותך רזה 😂😂😂", "timestamp": 1786686692, "like_count": 1}, {"author": "linoynoah", "author_id": "241901550", "id": "180