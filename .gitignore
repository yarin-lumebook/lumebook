# LumeBook monorepo. Raw media stays on disk only (re-downloadable or regenerated); code, data, docs and built pages are tracked.

# secrets: keys live in the shell (~/.zshrc) or the cloud environment, never in a file here; .env.example is the template
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*service-account*.json

# OS and tools
.DS_Store
._*
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
__pycache__/
*.py[cod]
node_modules/
venv/
dist/
build/
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
npm-debug.log*
.vercel/
.site-editor/
_preview-test.html
uploads/.tmp*

# generated state and outputs
.lumebook/
sites/dashboard/out/
sites/dashboard/site/
**/sheet.md
*.log

# raw research media
research/kids-brand-content-research/videos/
research/kids-brand-content-research/analysis/**/*.jpg
research/kids-brand-content-research/analysis/**/*.wav
research/carousel-research/slides/
research/carousel-research/img/
research/carousel-research/img2/
research/competitor-content-analysis/**/*.mp4

# media/: one home for every creative file (14 Oct 2026). Pictures, video and audio stay on disk only
# (big, and old projects go to the cloud); scripts, prompts, manifests and READMEs are tracked.
media/**/*.png
media/**/*.jpg
media/**/*.jpeg
media/**/*.webp
media/**/*.gif
media/**/*.pdf
media/**/*.mp3
media/**/*.m4a
media/**/*.wav
media/**/*.opus
media/**/*.srt
media/inbox/*
!media/inbox/README.md

# files we no longer need, waiting for Yarin to delete them (never tracked)
_to-delete/

# creator correspondence (private emails, DM recordings, terms drafts): one folder per handle, never tracked
creators/correspondence/*/
creators/correspondence/**/*.eml

# paid carousel production runs: final images and zips stay on disk
carousel/carousel-pipeline/approved/**/*.png
carousel/carousel-pipeline/approved/**/*.jpg
carousel/carousel-pipeline/approved/**/*.zip
carousel/carousel-pipeline/approved/**/versions/

# nightly drafts: rendered slides and downloaded product images stay on disk (re-rendered by finish-reco)
carousel/carousel-pipeline/drafts/**/*.png
carousel/carousel-pipeline/drafts/**/*.jpg
carousel/carousel-pipeline/drafts/**/*.webp

*.zip
*.mp4
*.mov
media/projects/2026-10-06-fal-carousel-trial/source/legacy-illustrated/slides-illustrated/
shared/design/_ds_artifact/
.venv/

# machine-local Claude settings
.claude/settings.local.json
.claude/scheduled_tasks.lock
