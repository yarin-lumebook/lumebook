        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "מה יעזור לי:",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "סיר קטן בגובה שלי,",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "שהרגליים שלי נוגעות ברצפה.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      }
    ]
