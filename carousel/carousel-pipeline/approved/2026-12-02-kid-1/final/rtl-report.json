      {
        "text": "1תחתונים של גדולים",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": true,
        "overflow": false
      },
      {
        "text": "אני בוחרת את התחתונים",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "תחתונים עם תותים, או עם כוכבים?",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "כשאני בוחרת בעצמי, זה מרגיש שלי.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "וכשאני לובשת אותם, אני גדולה באמת.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "תנו לי לעבור לתחתונים כבר כשמתחילים.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      }
    ]
  },
