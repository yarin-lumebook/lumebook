        "mixed": false,
        "overflow": false
      },
      {
        "text": "ואני מסתכלת עלייך,",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "והמילה נשארת לי בפה.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "אז הנה מה שהייתי עונה לך, אם יכולתי.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      }
