    "blocks": [
      {
        "text": "אני מכיר את המבט הזה",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "כשהקלף האחרון נופל ואני מפסיד,",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "אני זורק את הקלפים על הרצפה.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "ואת מסתכלת עליי, ככה.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "אני יודע מה עובר לך בראש.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "אז הנה התשובות שלי.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      }
    ]
  },
