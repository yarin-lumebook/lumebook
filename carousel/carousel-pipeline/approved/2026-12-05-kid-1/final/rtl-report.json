        "overflow": false
      },
      {
        "text": "משחק קצר שלא אכפת לי להפסיד בו.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "להפסיד בכוונה, ככה סתם,",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "ולהרגיש שזה לא סוף העולם.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      }
    ]
