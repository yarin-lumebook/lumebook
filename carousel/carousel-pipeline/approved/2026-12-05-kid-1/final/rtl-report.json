      {
        "text": "אמא, ״זה רק משחק״",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "לא עוזר לי",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "כשאני מפסיד",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "המחשבות שלך, והתשובות שלי",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      }
    ]
  },
