        "text": "מה יעזור לי:",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "תוכנית לגוף, עוד לפני המשחק.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "ידיים על הברכיים, נשימה ארוכה,",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "ואז אני מחליט מה אומרים.",
