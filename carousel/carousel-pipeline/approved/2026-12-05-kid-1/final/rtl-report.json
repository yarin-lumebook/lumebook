      {
        "text": "את חושבת:",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "״זה רק משחק, יואב״",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "בשבילך זה רק משחק.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "בשבילי זה כל העולם, עכשיו.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "מה יעזור לי לשמוע:",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "״אני רואה שזה ממש מבאס אותך.״",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "בלי ״לא נורא״, בלי לשפוט.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      }
    ]
  },
