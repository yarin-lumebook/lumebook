        "textAlign": "center",
        "mixed": true,
        "overflow": false
      },
      {
        "text": "אני מתעוררת ורצה אלייך",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "עוד לפני הנעליים, עוד לפני הכל.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "״אמא, היום יום ההולדת שלי?״",
