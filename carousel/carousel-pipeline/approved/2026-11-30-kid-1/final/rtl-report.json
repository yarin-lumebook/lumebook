        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "ואני לא מבינה כמה זה עוד לא.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "מה יעזור לי:",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "לוח על הקיר, עם היום שלי מסומן.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      }
    ]
  },
