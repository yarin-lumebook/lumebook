        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "אמא ואבא, זה היה קצת מפחיד.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      }
    ]
