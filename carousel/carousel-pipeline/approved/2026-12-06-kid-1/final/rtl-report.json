        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "אתם אומרים שאני כבר בת שלוש.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "והמוצץ? הוא איתי בכל מקום.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "באוטו, בסלון, מתחת לכרית.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "אז בבקשה, לא בבת אחת.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "הנה חמישה דברים שיעזרו לי.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      }
    ]
  },
