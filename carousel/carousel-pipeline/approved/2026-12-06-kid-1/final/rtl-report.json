        "mixed": false,
        "overflow": false
      },
      {
        "text": "״רוני, עוד שלושה לילות נגיד לו ביי.״",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      }
    ]
