        "textAlign": "center",
        "mixed": true,
        "overflow": false
      },
      {
        "text": "רק אני ואחד מכם",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "כל יום חצי שעה, בלי התינוק.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "אחד מכם, רק איתי, על השטיח.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "בונים מסילה, מדברים, צוחקים.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      },
      {
        "text": "ואני מרגיש שיש לי מקום אצלכם.",
        "direction": "rtl",
        "textAlign": "center",
        "mixed": false,
        "overflow": false
      }
    ]
