{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumebook.local/carousel-pipeline/pack.schema.json",
  "title": "LumeBook nightly carousel review pack",
  "description": "Structure of carousel/carousel-pipeline/drafts/YYYY-MM-DD/pack.json. scripts/validate_pack.py checks this structure and adds the rules a schema cannot express. Arc (packs from 2026-10-14 10:00, 10 slides and one picture per option): hook, 2 explains the idea, 3 to 8 show 1 or 2 numbered examples each, 9 recaps, and the last slide suggests a personalised story where the child is the hero together with the CTA. Every option is about one named Israeli girl or boy and talks to mom or to both parents, never to dad. No brand or book title anywhere. Audience facing Hebrew is: slide headline and body, caption, cta, code_word.",
  "type": "object",
  "required": [
    "schema_version",
    "date",
    "generated_at",
    "topic",
    "voice",
    "product_facts",
    "directions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        2,
        3
      ],
      "description": "3 since 8 Oct 2026: the pack carries a hook_slate and each option's hook records its slate candidate, mechanism and slide 2 move. Version 2 packs (before that) still validate with the older rules."
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "The morning this pack is for. Also the folder name."
    },
    "generated_at": {
      "type": "string",
      "minLength": 10,
      "description": "Local ISO timestamp of the run."
    },
    "topic": {
      "type": "object",
      "required": [
        "id",
        "title_he",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "An id from topic-bank.md"
        },
        "title_he": {
          "type": "string",
          "minLength": 2
        },
        "reason": {
          "type": "string",
          "minLength": 10,
          "description": "Why this topic tonight. Internal, punctuation allowed."
        },
        "event": {
          "$ref": "#/$defs/event",
          "description": "Only for an Israeli event pack (topic id event-...; topic-bank.md \"Israeli events\", Yarin 16 Oct 2026)."
        }
      }
    },
    "format": {
      "enum": [
        "two_topics"
      ],
      "description": "two_topics since 24 Oct 2026 (Yarin: \"2 topics that have a best-selling book ... 3 options for each\"): `topics` holds the day's two topics and one kid direction holds kid-1 to kid-6. Absent in older packs."
    },
    "cta_style": {
      "enum": [
        "save_share",
        "save_for_later"
      ],
      "description": "An older pack switched to a newer CTA: save_share (the save and share CTA under the fixed slide 10 headline, 24 Oct 2026) or save_for_later (slide 10 is only the CTA, תשמרי את הפוסט לפעם הבאה ש..., the evening of 24 Oct 2026; the week of 25 Oct was moved to it). Packs written after each change have it without this field."
    },
    "voice_style": {
      "enum": [
        "to_parents"
      ],
      "description": "An older pack moved to the child telling the parents (Yarin, 28 Oct 2026): every kid option is the child talking to mom or both parents, slides 1 to 9 and the caption in first person, no narrator. Packs generated from 2026-10-28 12:00 have it without this field."
    },
    "topics": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/pair_topic"
      },
      "description": "Two-topic packs only: topics[0] for kid-1 to kid-3, topics[1] for kid-4 to kid-6. `topic` repeats topics[0] for older readers."
    },
    "voice": {
      "type": "object",
      "required": [
        "status",
        "approved_samples",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "fallback",
            "calibrated"
          ]
        },
        "approved_samples": {
          "type": "integer",
          "minimum": 0
        },
        "note": {
          "type": "string"
        }
      }
    },
    "product_facts": {
      "type": "array",
      "minItems": 1,
      "description": "Product facts checked on the live site during this run. Claims of kind product_fact cite these ids.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "fact",
          "quote",
          "url",
          "checked_at"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^site-[a-z0-9-]+$"
          },
          "fact": {
            "type": "string",
            "minLength": 5
          },
          "quote": {
            "type": "string",
            "minLength": 3,
            "description": "Verbatim text from the page."
          },
          "url": {
            "type": "string",
            "pattern": "^https://lumebook\\.com/"
          },
          "checked_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "directions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/direction"
      }
    },
    "hook_slate": {
      "$ref": "#/$defs/hook_slate"
    }
  },
  "$defs": {
    "direction": {
      "type": "object",
      "required": [
        "id",
        "label_he",
        "versions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "kid",
            "expert"
          ]
        },
        "label_he": {
          "type": "string",
          "minLength": 2
        },
        "versions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/version"
          },
          "description": "3 per direction; 6 in the one kid direction of a two-topic pack (24 Oct 2026)"
        }
      }
    },
    "version": {
      "type": "object",
      "required": [
        "id",
        "title",
        "angle",
        "target_parent",
        "awareness_stage",
        "hook_family",
        "hook",
        "child_gender",
        "addressee",
        "child_name",
        "character_anchor",
        "slides",
        "caption",
        "cta",
        "sources",
        "claims",
        "conversion_rationale"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(kid-[1-6]|expert-[1-3])$",
          "description": "kid-1 to kid-3 and expert-1 to expert-3; a two-topic pack (24 Oct 2026) has kid-1 to kid-6"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "description": "Internal title, Hebrew preferred."
        },
        "angle": {
          "type": "string",
          "minLength": 10,
          "description": "Strategic angle. Internal."
        },
        "target_parent": {
          "type": "string",
          "minLength": 10,
          "description": "Who exactly this is for. Internal."
        },
        "awareness_stage": {
          "enum": [
            "unaware",
            "problem_aware",
            "solution_aware",
            "product_aware",
            "most_aware"
          ]
        },
        "hook_family": {
          "enum": [
            "moment",
            "child_quote",
            "child_pov",
            "practical_question",
            "reframe",
            "sentences_we_say",
            "parent_identity",
            "gentle_outcome",
            "story",
            "surprising_statement",
            "milestone",
            "gift",
            "objection",
            "demo",
            "normalising",
            "analogy"
          ]
        },
        "code_word": {
          "type": "string",
          "pattern": "^[א-ת]{2,10}$",
          "description": "The comment word (always לומי from 10 Oct 2026). Required before 24 Oct 2026; since then the CTA asks to save and share and there is no comment word"
        },
        "child_gender": {
          "enum": [
            "boy",
            "girl"
          ],
          "description": "One grammatical gender per carousel."
        },
        "character_anchor": {
          "type": "object",
          "required": [
            "child",
            "parent",
            "wardrobe"
          ],
          "additionalProperties": false,
          "properties": {
            "child": {
              "type": "string",
              "minLength": 20
            },
            "parent": {
              "type": "string",
              "minLength": 20
            },
            "wardrobe": {
              "type": "string",
              "minLength": 10
            }
          }
        },
        "expert_frame": {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "evidence_based_take",
                "named_expert"
              ]
            },
            "name": {
              "type": "string"
            },
            "source_id": {
              "type": "string"
            }
          }
        },
        "slides": {
          "type": "array",
          "minItems": 7,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/slide"
          },
          "description": "7 slides in packs before 2026-10-14 10:00, 10 slides since (Yarin, 14 Oct 2026)."
        },
        "caption": {
          "type": "string",
          "minLength": 20
        },
        "post_text": {
          "type": "object",
          "required": ["caption", "fb_text"],
          "properties": {
            "caption": {"type": "string", "minLength": 20},
            "fb_text": {"type": "string", "minLength": 20}
          },
          "description": "Packs from 2026-10-26 21:00 (Yarin: \"in the written captions add punctuation marks and emojis (dont overdo it only at cta and hooks)\"): the Instagram caption and the Facebook text (slides 2 to 10, a blank line between slides), the same words punctuated, one emoji ending the hook line and 🔖 ending the CTA."
        },
        "cta": {
          "type": "string",
          "minLength": 10
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "conversion_rationale": {
          "type": "string",
          "minLength": 20
        },
        "hook": {
          "type": "object",
          "required": [
            "formula",
            "gap",
            "payoff_slide",
            "score"
          ],
          "additionalProperties": false,
          "description": "Slide 1 is built from a formula in hook-bank.md and scored with the hook formula there.",
          "properties": {
            "formula": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "gap": {
              "type": "string",
              "minLength": 8,
              "description": "The question the hook opens. Internal."
            },
            "payoff_slide": {
              "type": "integer",
              "minimum": 2,
              "maximum": 9
            },
            "score": {
              "type": "object",
              "required": [
                "specific",
                "feeling",
                "honest_gap",
                "short_spoken",
                "filters",
                "not_an_ad"
              ],
              "additionalProperties": false,
              "properties": {
                "specific": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2
                },
                "feeling": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2
                },
                "honest_gap": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2
                },
                "short_spoken": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2
                },
                "filters": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2
                },
                "not_an_ad": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2
                }
              }
            },
            "slate_id": {
              "type": "string",
              "pattern": "^[keab][1-6]$",
              "description": "The hook_slate candidate this option was built from (k1 to k6 for kid, e1 to e6 for expert). Required from schema_version 3."
            },
            "mechanism": {
              "enum": [
                "recognition",
                "perspective_shift",
                "honest_curiosity",
                "reassurance",
                "practical_utility",
                "reframe",
                "narrative_tension",
                "anticipation",
                "identity_filter"
              ],
              "description": "The hook's psychological job, one of the formula's mechanisms in hook-bank.md. Required from schema_version 3."
            },
            "slide2_move": {
              "enum": [
                "zoom_in",
                "other_side",
                "name_trigger",
                "contrast",
                "promise",
                "first_answer",
                "scene_restart",
                "same_template"
              ],
              "description": "How slide 2 works as a standalone opening (hook-bank.md slide 2 moves). Required from schema_version 3."
            }
          }
        },
        "child_name": {
          "type": "string",
          "pattern": "^[א-ת]{2,8}$",
          "description": "An Israeli first name from names.md, matching child_gender."
        },
        "addressee": {
          "enum": [
            "mom",
            "parents"
          ],
          "description": "Who the copy talks to: mom (feminine singular) or both parents (plural). Never dad."
        },
        "examples_target": {
          "type": "integer",
          "minimum": 3,
          "maximum": 9,
          "description": "6 to 9 in packs from 2026-10-14 10:00 (3 to 7 before). This option's number of examples from tonight's draw (nightly.py start, examples_per_option)."
        },
        "image": {
          "$ref": "#/$defs/image",
          "description": "Packs from 2026-10-14 10:00: the ONE picture for the whole carousel, depicting the idea; it is also the cover (child facing the viewer), shown behind every slide. Slides then carry no image of their own."
        },
        "topic_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Two-topic packs: the topic this option is about (topics[0] for kid-1 to kid-3, topics[1] for kid-4 to kid-6)"
        }
      }
    },
    "slide": {
      "type": "object",
      "required": [
        "number",
        "role",
        "headline",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "role": {
          "enum": [
            "hook",
            "second_hook",
            "recognition",
            "reframe",
            "solution",
            "resolution",
            "example",
            "explain",
            "recap",
            "story_cta"
          ]
        },
        "headline": {
          "type": "string",
          "minLength": 2
        },
        "body": {
          "type": "string",
          "description": "May be empty. Lines separated by newlines."
        },
        "highlight": {
          "type": "string",
          "description": "The 1 to 3 whole words of the headline that get the colour block on the slide (bold look, packs from 10 Oct 2026 18:30). Required on slides 1 to 6 of those packs."
        },
        "image": {
          "$ref": "#/$defs/image",
          "description": "Packs before 2026-10-14 10:00 only: this slide's own picture (required there)."
        },
        "pull": {
          "type": "object",
          "required": [
            "type",
            "note"
          ],
          "additionalProperties": false,
          "description": "Slides 1 to 6: what pulls the reader to the next slide. Internal.",
          "properties": {
            "type": {
              "enum": [
                "question",
                "open_loop",
                "next_step",
                "contrast",
                "numbered"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 5
            }
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Packs from 2026-10-14 10:00: slides 3 to 8 each list their 1 or 2 numbered examples, each written on the slide right after its number (numbered 1, 2, 3... across the carousel); the total is the option's examples_target and the other slides list none (Yarin, 14 Oct 2026). Older packs: only when the slide lists examples, 3 to 7 items, exactly the option's examples_target (Yarin, 10 Oct 2026)."
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "beat",
        "action",
        "setting",
        "camera",
        "lighting",
        "wardrobe_objects",
        "text_zone"
      ],
      "additionalProperties": false,
      "description": "English scene brief. scripts/carousel_lib.py compose_image_prompt() turns it into the exact model prompt (adds the character anchor, style, palette, text zone and no-text rules).",
      "properties": {
        "beat": {
          "type": "string",
          "minLength": 5
        },
        "action": {
          "type": "string",
          "minLength": 10
        },
        "setting": {
          "type": "string",
          "minLength": 5
        },
        "camera": {
          "type": "string",
          "minLength": 5
        },
        "lighting": {
          "type": "string",
          "minLength": 5
        },
        "wardrobe_objects": {
          "type": "string",
          "minLength": 5
        },
        "text_zone": {
          "type": "object",
          "required": [
            "edge",
            "percent",
            "surface"
          ],
          "additionalProperties": false,
          "properties": {
            "edge": {
              "enum": [
                "top",
                "bottom"
              ]
            },
            "percent": {
              "type": "integer",
              "minimum": 30,
              "maximum": 50
            },
            "surface": {
              "type": "string",
              "minLength": 5
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "title",
        "publisher",
        "url",
        "accessed",
        "quote",
        "supports"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^src-[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "publisher": {
          "type": "string",
          "minLength": 2
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "accessed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "quote": {
          "type": "string",
          "minLength": 10,
          "description": "Verbatim excerpt that was read."
        },
        "supports": {
          "type": "string",
          "minLength": 10,
          "description": "What this source supports, in plain words."
        }
      }
    },
    "claim": {
      "type": "object",
      "required": [
        "slide",
        "wording_he",
        "kind",
        "source_ids",
        "supports"
      ],
      "additionalProperties": false,
      "properties": {
        "slide": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "wording_he": {
          "type": "string",
          "minLength": 2
        },
        "kind": {
          "enum": [
            "sourced_fact",
            "product_fact",
            "lumebook_wording"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supports": {
          "type": "string",
          "description": "What the cited source supports, or why this is only LumeBook wording."
        }
      }
    },
    "hook_slate": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "description": "Private working slate written before the six options (hook-bank.md, Nightly hook slate). Internal, never shown to parents. Required from schema_version 3. Packs before 24 Oct 2026: `kid` and `expert`, 6 each. Two-topic packs: `a` (topics[0]) and `b` (topics[1]), 6 child-voice candidates each.",
      "properties": {
        "kid": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/slate_candidate"
          }
        },
        "expert": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/slate_candidate"
          }
        },
        "a": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/slate_candidate"
          }
        },
        "b": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/slate_candidate"
          }
        }
      }
    },
    "slate_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "formula",
        "family",
        "hook",
        "slide2",
        "slide2_move",
        "mechanism",
        "awareness_stage",
        "gap",
        "payoff_slide",
        "answer",
        "factual_claim",
        "score",
        "fail_checks",
        "used_by"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[keab][1-6]$"
        },
        "formula": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "family": {
          "enum": [
            "moment",
            "child_quote",
            "child_pov",
            "practical_question",
            "reframe",
            "sentences_we_say",
            "parent_identity",
            "gentle_outcome",
            "story",
            "surprising_statement",
            "milestone",
            "gift",
            "objection",
            "demo",
            "normalising",
            "analogy"
          ]
        },
        "hook": {
          "type": "string",
          "minLength": 2,
          "description": "Slide 1 text as it would appear (headline lines, then body lines, separated by newlines). Audience Hebrew."
        },
        "slide2": {
          "type": "string",
          "minLength": 2,
          "description": "Slide 2 text. Must work as a first slide on its own. Audience Hebrew."
        },
        "slide2_move": {
          "enum": [
            "zoom_in",
            "other_side",
            "name_trigger",
            "contrast",
            "promise",
            "first_answer",
            "scene_restart",
            "same_template"
          ]
        },
        "mechanism": {
          "enum": [
            "recognition",
            "perspective_shift",
            "honest_curiosity",
            "reassurance",
            "practical_utility",
            "reframe",
            "narrative_tension",
            "anticipation",
            "identity_filter"
          ]
        },
        "awareness_stage": {
          "enum": [
            "unaware",
            "problem_aware",
            "solution_aware",
            "product_aware",
            "most_aware"
          ]
        },
        "gap": {
          "type": "string",
          "minLength": 8,
          "description": "The exact question the hook opens. Internal."
        },
        "payoff_slide": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9
        },
        "answer": {
          "type": "string",
          "minLength": 8,
          "description": "How that slide closes the question, in one line. Internal."
        },
        "factual_claim": {
          "type": "boolean",
          "description": "True when slide 1 or 2 states something about children in general (a fact). The option must then map a sourced_fact claim to slide 1 or 2."
        },
        "score": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stopping_power",
            "specificity",
            "parent_relevance",
            "honest_curiosity",
            "emotional_truth",
            "swipe_promise",
            "usefulness",
            "topic_fit",
            "lumebook_fit",
            "freshness"
          ],
          "properties": {
            "stopping_power": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "specificity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "parent_relevance": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "honest_curiosity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "emotional_truth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "swipe_promise": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "usefulness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "topic_fit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "lumebook_fit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "freshness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            }
          }
        },
        "fail_checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "clickbait",
            "unsupported_claim",
            "unfulfilled_promise",
            "blames_parent"
          ],
          "properties": {
            "clickbait": {
              "type": "boolean"
            },
            "unsupported_claim": {
              "type": "boolean"
            },
            "unfulfilled_promise": {
              "type": "boolean"
            },
            "blames_parent": {
              "type": "boolean"
            }
          },
          "description": "Any true means the candidate fails and cannot be used."
        },
        "used_by": {
          "type": "string",
          "pattern": "^(kid-[1-6]|expert-[1-3])?$",
          "description": "The option built from this candidate, or empty. Never a ranking: the system does not pick a winner."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name_he",
        "date",
        "kind",
        "tone",
        "source"
      ],
      "properties": {
        "name_he": {
          "type": "string",
          "minLength": 2,
          "description": "The event as Israelis call it (חנוכה, יום המשפחה)."
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "The day it happens (the first day for a holiday), from the source."
        },
        "end_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "kind": {
          "enum": [
            "holiday",
            "special_day",
            "news"
          ]
        },
        "tone": {
          "enum": [
            "hard",
            "exciting",
            "calm"
          ]
        },
        "post_by": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "The last good day to post it."
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "publisher",
            "quote",
            "accessed"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https?://"
            },
            "publisher": {
              "type": "string",
              "minLength": 2
            },
            "quote": {
              "type": "string",
              "minLength": 5,
              "description": "Verbatim, says the date or the event."
            },
            "accessed": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "talk_source": {
          "type": "object",
          "description": "Hard moments: the official guidance on talking with children that the slides follow.",
          "additionalProperties": false,
          "required": [
            "url",
            "publisher",
            "quote",
            "accessed"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https?://"
            },
            "publisher": {
              "type": "string",
              "minLength": 2
            },
            "quote": {
              "type": "string",
              "minLength": 5
            },
            "accessed": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        }
      }
    },
    "pair_topic": {
      "type": "object",
      "required": [
        "id",
        "title_he",
        "reason",
        "book"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "A topic-bank.md id listed under \"Best-selling books\""
        },
        "title_he": {
          "type": "string",
          "minLength": 2
        },
        "reason": {
          "type": "string",
          "minLength": 10,
          "description": "Why this topic today. Internal, punctuation allowed."
        },
        "book": {
          "type": "object",
          "required": [
            "id",
            "title_he"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1,
              "description": "lumebook.com/IL/he/books/<id>"
            },
            "title_he": {
              "type": "string",
              "minLength": 2
            },
            "checked_at": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "description": "The best-selling book behind the topic. Never named on the slides, caption or CTA."
        }
      }
    }
  }
}
